      "pattern": "^[A-Za-z0-9 ,'\"-]{1,200}$"
    },
    "font.heading": {
      "property": "--hc-font-heading",
      "kind": "font",
      "pattern": "^[A-Za-z0-9 ,'\"-]{1,200}$"
    },
    "radius.lg": {
